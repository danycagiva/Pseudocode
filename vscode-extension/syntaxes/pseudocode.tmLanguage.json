{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PseudoCode",
  "scopeName": "source.pseudocode",
  "patterns": [
    { "include": "#kommentar" },
    { "include": "#zeichenkette" },
    { "include": "#schluesselwoerter" },
    { "include": "#wahrheitswerte" },
    { "include": "#eingebaute_funktionen" },
    { "include": "#zahl" },
    { "include": "#bezeichner" },
    { "include": "#operator" }
  ],
  "repository": {
    "kommentar": {
      "name": "comment.line.double-slash.pseudocode",
      "match": "//.*$"
    },
    "zeichenkette": {
      "name": "string.quoted.double.pseudocode",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.pseudocode",
          "match": "\\\\."
        }
      ]
    },
    "schluesselwoerter": {
      "patterns": [
        {
          "name": "keyword.control.end.pseudocode",
          "match": "\\b(endewenn|endesolange|endefuer|endefunktion|ende)\\b"
        },
        {
          "name": "keyword.control.pseudocode",
          "match": "\\b(wenn|dann|sonstwenn|sonst|solange|tue|fuer|von|bis|schrittweite)\\b"
        },
        {
          "name": "keyword.declaration.pseudocode",
          "match": "\\b(funktion|rueckgabe|sei|liste)\\b"
        },
        {
          "name": "keyword.operator.logical.pseudocode",
          "match": "\\b(und|oder|nicht)\\b"
        }
      ]
    },
    "wahrheitswerte": {
      "name": "constant.language.pseudocode",
      "match": "\\b(wahr|falsch)\\b"
    },
    "eingebaute_funktionen": {
      "name": "support.function.builtin.pseudocode",
      "match": "\\b(ausgabe|abs|runden|boden|decke|wurzel|laenge|text|zahl|eingabe|datentyp)\\b(?=\\s*\\()"
    },
    "zahl": {
      "name": "constant.numeric.pseudocode",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "bezeichner": {
      "name": "variable.other.pseudocode",
      "match": "[a-zA-ZäöüÄÖÜß_][a-zA-ZäöüÄÖÜß_0-9]*"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.pseudocode",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.pseudocode",
          "match": "(!=|<=|>=|<|>|=)"
        },
        {
          "name": "keyword.operator.arithmetic.pseudocode",
          "match": "(\\+\\+|--|[+\\-*/%])"
        }
      ]
    }
  }
}
